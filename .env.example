# TerraLearn frontend environment (Vite). Copy to .env.local and fill in.
# All VITE_-prefixed vars are bundled into the client -- never put secrets here.
# The whole app (simulator + Saath) is auth-gated: Clerk + Supabase are required
# for local dev. Without them only a limited simulator view loads.

# FastAPI backend base URL. Defaults to http://127.0.0.1:8000 when unset.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Supabase project (Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clerk (API Keys). Use the pk_test_ key for dev.
VITE_CLERK_PUBLISHABLE_KEY=
