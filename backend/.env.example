OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
# openai/gpt-oss-120b is Groq's recommended replacement after llama-3.3-70b-versatile
# was decommissioned (2026-06-17). Must match OPENAI_MODEL in render.yaml.
# base_url/model are swappable — point at OpenAI/Ollama/any OpenAI-compatible endpoint without code changes

# Optional Fallback Provider (OpenRouter)
# OpenRouter free-tier model IDs rotate — verify live IDs at openrouter.ai/models before relying on them
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct

# RAG knowledge base — Supabase pgvector + the `embed` edge function (gte-small, 384-dim).
# Both are public/safe (the anon key is already in the frontend bundle). Same values the
# frontend uses as VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=https://qrkjbdvbehvklaqgotrv.supabase.co
SUPABASE_ANON_KEY=

# --- MCP refresh layer + Farmer MCP server + IVR harness (Puppeteer MCP spec) ---
# Service-role key: NEVER expose this to the frontend or log it. It bypasses
# RLS entirely — used only by backend/app/refresh/supabase_admin.py and
# backend/app/mcp/supabase_owner.py to read/write owner-scoped rows that have
# no Clerk JWT to authenticate against. Get it from Supabase dashboard >
# Project Settings > API > service_role (secret). Supabase's newer key system
# calls this a "secret key" (sb_secret_...) instead of a service_role JWT —
# either format works here, it's just passed through as a bearer token.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side Agmarknet key for the 30-minute batch refresh job. Reuses the
# same data.gov.in key value as the frontend's bundled VITE_AGMARKNET_API_KEY
# for now (hackathon scale) — provision a second key if the batch job and live
# frontend traffic start contending on data.gov.in's rate limit.
AGMARKNET_API_KEY=

# Fixed state used for every Agmarknet commodity refresh target — there is no
# district/state column anywhere in the schema (only free-text farmers.village),
# and Agmarknet only filters by state, so this is a stated assumption rather
# than a per-farmer derivation.
MARKET_REFRESH_STATE=Karnataka

# Shared secret required in the X-Internal-Token header on /internal/* routes
# (refresh triggers, IVR simulate). Generate a random value, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
INTERNAL_REFRESH_TOKEN=

# Comma-separated Host header allowlist for the MCP SDK's DNS-rebinding
# protection on /mcp/farmer (mcp.server.transport_security.TransportSecuritySettings).
# Include every host this backend is actually reached on. Defaults to
# localhost variants only if unset — set this explicitly on Render.
MCP_ALLOWED_HOSTS=127.0.0.1:8000,localhost:8000
